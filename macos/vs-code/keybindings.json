// Place your key bindings in this file to override the defaultsauto[]
[
    // Set `Ctrl + /` for commenting
    {
        "key": "cmd+numpad_divide",
        "command": "editor.action.commentLine",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "shift+cmd+7",
        "command": "-editor.action.commentLine",
        "when": "editorTextFocus && !editorReadonly"
    },
    // Set `Shift Shift` for commands
    {
        "key": "shift shift",
        "command": "workbench.action.showCommands"
    },
    {
        "key": "ctrl+shift+p",
        "command": "-workbench.action.showCommands"
    },
    // Set `Ctrl Ctrl` for quick file open.
    // Some keyboards swap physical Ctrl and Cmd in macOS, so include both.
    {
        "key": "meta meta",
        "command": "workbench.action.quickOpen"
    },
    {
        "key": "cmd+p",
        "command": "-workbench.action.quickOpen"
    },
    // Set `Alt Alt` for sidebar.
    {
        "key": "alt alt",
        "command": "workbench.action.toggleSidebarVisibility"
    },
    {
        "key": "ctrl+b",
        "command": "-workbench.action.toggleSidebarVisibility"
    },
    // Windows to MacOS rebindings
    // Physical Ctrl sends Cmd after OS remap, so map Cmd+<key> to send
    // the actual Ctrl+<key> byte to the terminal.
    // Ctrl+A=\u0001, Ctrl+B=\u0002, ... Ctrl+Z=\u001a
    {
        "key": "cmd+a",
        "command": "workbench.action.terminal.sendSequence",
        "args": { "text": "\u0001" },
        "when": "terminalFocus"
    },
    {
        "key": "cmd+b",
        "command": "workbench.action.terminal.sendSequence",
        "args": { "text": "\u0002" },
        "when": "terminalFocus"
    },
    {
        "key": "cmd+c",
        "command": "workbench.action.terminal.sendSequence",
        "args": { "text": "\u0003" },
        "when": "terminalFocus && !terminalTextSelected"
    },
    {
        "key": "cmd+d",
        "command": "workbench.action.terminal.sendSequence",
        "args": { "text": "\u0004" },
        "when": "terminalFocus"
    },
    {
        "key": "cmd+e",
        "command": "workbench.action.terminal.sendSequence",
        "args": { "text": "\u0005" },
        "when": "terminalFocus"
    },
