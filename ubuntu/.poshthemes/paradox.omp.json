{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "session",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "background": "#ffffff",
          "foreground": "#000000",
          "template": " {{ .UserName }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "background": "#4d4d4d",
          "foreground": "#ffffff",
          "properties": {
            "style": "agnoster_short",
            "max_depth": 3,
            "home_icon": "\ueb06 ",
            "folder_icon": "\u2026 ",
            "folder_separator_icon": " \ue0b1 "
          },
          "template": " {{ .Path }} "
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "background": "#6fff82",
          "foreground": "#000000",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#ffad55{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#54433a{{ end }}",
            "{{ if gt .Ahead 0 }}#744d89{{ end }}",
            "{{ if gt .Behind 0 }}#744d89{{ end }}"
          ],
          "properties": {
            "fetch_upstream_icon": true,
            "fetch_status": true,
            "fetch_stash_count": true
          },
          "template": " {{ .UpstreamIcon }} {{ .HEAD }}{{ if .Working.Changed }} <transparent>\ue0b1</> <#121318>\uf044 {{ .Working.String }}</>{{ end }}{{ if .Staging.Changed }} <transparent>\ue0b1</> <#121318>\uf046 {{ .Staging.String }}</>{{ end }}{{ if gt .StashCount 0 }} <transparent>\ue0b1</> <#121318>\ueb4b {{ .StashCount }}</>{{ end }} "
        },
        {
          "type": "python",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "background": "#906cff",
          "foreground": "#100e23",
          "template": " \ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }} "
        },
        {
          "type": "status",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "background": "#ff8080",
          "foreground": "#ffffff",
          "template": " \ue20f "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#4d4d4d",
          "template": "\u276f "
        }
      ]
    }
  ],
  "version": 2
}
