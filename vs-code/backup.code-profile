ispererConnectionExpired\\\": true\\r\\n  },\\r\\n}\"}","keybindings":"{\"keybindings\":\"// Place your key bindings in this file to override the defaultsauto[]\\n[\\n    // Set `Ctrl + /` for commenting\\n    {\\n        \\\"key\\\": \\\"ctrl+numpad_divide\\\",\\n        \\\"command\\\": \\\"editor.action.commentLine\\\",\\n        \\\"when\\\": \\\"editorTextFocus && !editorReadonly\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"ctrl+oem_2\\\",\\n        \\\"command\\\": \\\"-editor.action.commentLine\\\",\\n        \\\"when\\\": \\\"editorTextFocus && !editorReadonly\\\"\\n    },\\n    // Set `Shift Shift` for commands\\n    {\\n        \\\"key\\\": \\\"shift shift\\\",\\n        \\\"command\\\": \\\"workbench.action.showCommands\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"ctrl+shift+p\\\",\\n        \\\"command\\\": \\\"-workbench.action.showCommands\\\"\\n    },\\n    // Set `Ctrl Ctrl` for quick open\\n    {\\n        \\\"key\\\": \\\"ctrl ctrl\\\",\\n        \\\"command\\\": \\\"workbench.action.quickOpen\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"ctrl+p\\\",\\n        \\\"command\\\": \\\"-workbench.action.quickOpen\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"ctrl+e\\\",\\n        \\\"command\\\": \\\"-workbench.action.quickOpen\\\"\\n    },\\n    // Set `Alt Alt` for sidebar\\n    {\\n        \\\"key\\\": \\\"alt alt\\\",\\n        \\\"command\\\": \\\"workbench.action.toggleSidebarVisibility\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"ctrl+b\\\",\\n        \\\"command\\\": \\\"-workbench.action.toggleSidebarVisibility\\\"\\n    },\\n]\",\"platform\":3}","extensions":"[{\"identifier\":{\"id\":\"amazonwebservices.amazon-q-vscode\",\"uuid\":\"ca77fcb4-e1aa-4cab-ba31-cbdd9436df50\"},\"displayName\":\"Amazon Q\"},{\"identifier\":{\"id\":\"amazonwebservices.aws-toolkit-vscode\",\"uuid\":\"ac5787df-9b2d-441c-abf0-977d62bc66f0\"},\"displayName\":\"AWS Toolkit\"},{\"identifier\":{\"id\":\"astro-build.astro-vscode\",\"uuid\":\"1fbbc8b0-7432-4b7e-87